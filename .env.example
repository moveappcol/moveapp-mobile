# Misma publishable key que usa la web (move-app/.env.local) — comparten la
# misma cuenta de Clerk, así los usuarios son los mismos en app y web.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# URL base de la API del backend (move-app). En desarrollo local con el
# simulador/emulador en la misma Mac, http://localhost:3000/api/mobile
# funciona. Desde un teléfono físico hace falta la IP de la red local
# (ej. http://192.168.1.5:3000/api/mobile). En producción:
# https://www.uniqueappcol.com/api/mobile
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/mobile
